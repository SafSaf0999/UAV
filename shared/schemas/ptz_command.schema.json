{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["command"],
  "properties": {
    "command": { "type": "string", "enum": ["zoom_in", "zoom_out", "zoom_set", "rotate_left", "rotate_right", "rotate_set", "tilt_up", "tilt_down", "tilt_set", "reset_home"] },
    "zoom_level": { "type": "number" },
    "pan_angle": { "type": "number" },
    "tilt_angle": { "type": "number" }
  }
}

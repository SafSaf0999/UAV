# Mosquitto MQTT Broker Configuration Template
# Environment variables are substituted at container start via entrypoint.sh
# Variables: MQTT_PORT, MQTT_TLS_CA, MQTT_TLS_CERT, MQTT_TLS_KEY,
#            MQTT_AUTH_MODE (cert | password | both), MQTT_PASSWORD_FILE

# ── General ──────────────────────────────────────────────────────────────────
per_listener_settings true

# Persistent message store for retained status messages
persistence true
persistence_location /mosquitto/data/

# Logging
log_dest stdout
log_type error
log_type warning
log_type notice
log_type information
log_timestamp true

# ── Internal plain listener (Docker network only, port 1883) ─────────────────
# Used by aggregation service and other internal containers.
# Not exposed outside Docker — see docker-compose.yml (no host port mapping).
listener 1883
allow_anonymous true

# ── TLS Listener (external edge devices, port 8883) ──────────────────────────
listener ${MQTT_PORT}

# TLS configuration
cafile ${MQTT_TLS_CA}
certfile ${MQTT_TLS_CERT}
keyfile ${MQTT_TLS_KEY}

# TLS protocol — require TLS 1.2 or higher
tls_version tlsv1.2

# Certificate-based authentication
# Controlled by MQTT_AUTH_MODE: cert | password | both
require_certificate ${REQUIRE_CERTIFICATE}

# Use the CN from the client certificate as the username (when cert auth is active)
use_identity_as_username ${USE_IDENTITY_AS_USERNAME}

# Password file (used when MQTT_AUTH_MODE is "password" or "both")
${PASSWORD_FILE_LINE}

allow_anonymous false

# ── Connection Limits ─────────────────────────────────────────────────────────
max_connections 200

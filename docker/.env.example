# Anti-UAV Detection System — Main Device Environment Variables
# Copy this file to .env and fill in values for your deployment.
# .env is excluded from version control (see .gitignore).

# ── MQTT Broker ───────────────────────────────────────────────────────────────
# Port the Mosquitto broker listens on (publicly exposed for internet-connected edge devices)
MQTT_PORT=8883

# Paths to TLS credentials inside the container (mounted from secrets/)
MQTT_TLS_CA=/secrets/ca.crt
MQTT_TLS_CERT=/secrets/server.crt
MQTT_TLS_KEY=/secrets/server.key

# Authentication mode: cert | password | both
MQTT_AUTH_MODE=cert

# Path to password file inside the container (required when MQTT_AUTH_MODE=password or both)
MQTT_PASSWORD_FILE=/secrets/passwd

# ── Service Ports ─────────────────────────────────────────────────────────────
AGGREGATION_PORT=8001
CONTROL_CENTER_PORT=8080
SIGNALING_PORT=8090

# ── Remote Access ─────────────────────────────────────────────────────────────
# Remote access mode: vpn | https | local
# vpn   — Control Center bound to WireGuard interface only (recommended)
# https — nginx reverse proxy with TLS + token auth (non-VPN mode)
# local — Control Center accessible on local network only
REMOTE_ACCESS_MODE=vpn

# Bearer token for HTTPS non-VPN mode (change this to a strong random value)
HTTPS_TOKEN=changeme

# ── Optional Features ─────────────────────────────────────────────────────────
# Enable radar system integration
RADAR_ENABLED=false

# Tile server URL for the frontend map (self-hosted via tile-server service)
TILE_SERVER_URL=http://localhost:8070

# ── Authentication ────────────────────────────────────────────────────────────
# Secret key for signing JWTs — change to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# JWT expiry in hours (default 8h; "remember me" uses 30 days)
JWT_TTL_HOURS=8

# Bootstrap admin account — created on first startup if no users exist
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme
